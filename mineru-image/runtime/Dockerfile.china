# syntax=docker/dockerfile:1
# China mirrors variant of runtime image.

# ARGs used in FROM must be declared before the first FROM.
ARG UV_VERSION=0.7.13
ARG SOURCE_IMAGE=mineru-src:latest
ARG MODELS_IMAGE=mineru-vllm:v2.7.4-fix

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM ${SOURCE_IMAGE} AS src
FROM ${MODELS_IMAGE} AS models

FROM docker.m.daocloud.io/vllm/vllm-openai:v0.10.1.1

# Re-declare build args for this stage (FROM resets ARG scope).
ARG MINERU_EXTRAS=core
ARG UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        fontconfig \
        fonts-noto-cjk \
        fonts-noto-core \
        libgl1 && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /workspace

RUN --mount=type=bind,from=src,source=/src,target=/mnt/src,readonly \
    --mount=type=cache,target=/root/.cache/uv \
    sh -ec '\
      test -f /mnt/src/pyproject.toml || (echo "source image missing /src/pyproject.toml; rebuild mineru-source from repo root" >&2; ls -la /mnt/src >&2; exit 1); \
      cp -a /mnt/src /tmp/mineru-src; \
      uv pip install --system --index-url "${UV_INDEX_URL}" "/tmp/mineru-src[${MINERU_EXTRAS}]"; \
      rm -rf /tmp/mineru-src \
    '

# Reuse models + mineru.json from a pre-built image (e.g. official PyPI image),
# instead of downloading again during build.
RUN --mount=type=bind,from=models,source=/root,target=/mnt/models,readonly \
    sh -ec '\
      test -f /mnt/models/mineru.json || (echo "models image missing /root/mineru.json; set MODELS_IMAGE to an image with downloaded models" >&2; exit 1); \
      cp -a /mnt/models/mineru.json /root/mineru.json; \
      if [ -d /mnt/models/.cache ]; then \
        mkdir -p /root/.cache; \
        cp -a /mnt/models/.cache/. /root/.cache/; \
      fi \
    '

ENTRYPOINT ["/bin/bash", "-c", "export MINERU_MODEL_SOURCE=local && exec \"$@\"", "--"]
